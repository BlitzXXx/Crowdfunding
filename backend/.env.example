# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/crowdfunding"
# For production, use your hosted database URL from Railway, Supabase, etc.

# Blockchain Configuration
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CONTRACT_ADDRESS=your_deployed_factory_contract_address

# IPFS Configuration (Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_api_key
PINATA_JWT=your_pinata_jwt_token

# Alternative: NFT.Storage
# NFT_STORAGE_API_KEY=your_nft_storage_key

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
# For production, set to your frontend URL

# JWT Secret (if implementing authentication)
JWT_SECRET=your_random_jwt_secret_key_here

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
# Options: error, warn, info, http, verbose, debug, silly
