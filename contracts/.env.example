# Hardhat Environment Variables
# Copy this file to .env and fill in your values

# Network RPC URLs
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# or use Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key for deployment (NEVER commit the actual .env file!)
# Use a testnet-only wallet with small amounts of ETH
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: Mainnet RPC (for production deployment)
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Optional: Polygon Mumbai (alternative testnet)
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Gas reporting
COINMARKETCAP_API_KEY=your_coinmarketcap_key_for_gas_prices
