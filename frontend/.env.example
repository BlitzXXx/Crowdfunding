# Frontend Environment Variables
# Copy this file to .env and fill in your values
# Note: Vite requires variables to be prefixed with VITE_

# Smart Contract Configuration
VITE_FACTORY_CONTRACT_ADDRESS=0xYourDeployedFactoryAddress
VITE_CHAIN_ID=11155111
# Chain IDs: Sepolia=11155111, Mainnet=1, Polygon=137, Mumbai=80001

# RPC Configuration (Optional - for read-only operations)
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# The Graph Subgraph
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_ACCOUNT/crowdfunding-platform/v0.0.1

# Backend API
VITE_BACKEND_URL=http://localhost:3001
# For production, use your deployed backend URL

# IPFS Gateway
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# or https://ipfs.io/ipfs/
# or https://YOUR_ACCOUNT.mypinata.cloud/ipfs/

# Application Configuration
VITE_APP_NAME="Crowdfunding DApp"
VITE_NETWORK_NAME=Sepolia
# For mainnet: Ethereum or Polygon

# Feature Flags (Optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Analytics (Optional - if you add analytics)
# VITE_GA_TRACKING_ID=your_google_analytics_id
# VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Error Tracking (Optional - Sentry)
# VITE_SENTRY_DSN=your_sentry_dsn
