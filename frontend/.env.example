# Frontend Environment Variables
# Copy to .env and fill in

# Chain: "localhost" targets Hardhat (31337); anything else targets Sepolia
VITE_CHAIN=

# Deployed CrowdfundingFactory address (required)
VITE_FACTORY_ADDRESS=

# Subgraph GraphQL endpoint (optional — enables indexed queries + user history)
VITE_SUBGRAPH_URL=

# Backend API base (defaults http://localhost:3001)
VITE_API_URL=http://localhost:3001

# WalletConnect project id (optional, for mobile wallet support)
VITE_WALLETCONNECT_PROJECT_ID=
