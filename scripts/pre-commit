#!/bin/bash
# CrowdChain pre-commit hook
# Runs lint and typecheck on changed files before allowing commits.
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: bash scripts/install-hooks.sh

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Get list of staged files
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
  exit 0
fi

echo "🔍 Pre-commit checks..."

FAILED=0

# ─── Backend checks ────────────────────────────────────────
BACKEND_FILES=$(echo "$STAGED" | grep "^backend/" || true)
if [ -n "$BACKEND_FILES" ]; then
  echo "  Checking backend..."

  # Typecheck
  if ! cd backend && npx tsc --noEmit 2>/dev/null; then
    echo -e "${RED}✗ Backend typecheck failed${NC}"
    FAILED=1
  fi
  cd ..

  # Lint
  if ! cd backend && npx eslint . 2>/dev/null; then
    echo -e "${RED}✗ Backend lint failed${NC}"
    FAILED=1
  fi
  cd ..
fi

# ─── Frontend checks ───────────────────────────────────────
FRONTEND_FILES=$(echo "$STAGED" | grep "^frontend/" || true)
if [ -n "$FRONTEND_FILES" ]; then
  echo "  Checking frontend..."

  # Typecheck
  if ! cd frontend && npx tsc --noEmit 2>/dev/null; then
    echo -e "${RED}✗ Frontend typecheck failed${NC}"
    FAILED=1
  fi
  cd ..

  # Lint (only ts/tsx files)
  TS_FILES=$(echo "$FRONTEND_FILES" | grep -E "\.(ts|tsx)$" || true)
  if [ -n "$TS_FILES" ]; then
    if ! cd frontend && npx eslint $(echo "$TS_FILES" | sed 's|^frontend/||') 2>/dev/null; then
      echo -e "${RED}✗ Frontend lint failed${NC}"
      FAILED=1
    fi
    cd ..
  fi
fi

# ─── Contracts checks ──────────────────────────────────────
CONTRACTS_FILES=$(echo "$STAGED" | grep "^contracts/" || true)
if [ -n "$CONTRACTS_FILES" ]; then
  SOL_FILES=$(echo "$CONTRACTS_FILES" | grep "\.sol$" || true)
  if [ -n "$SOL_FILES" ]; then
    echo "  Checking Solidity compilation..."
    if ! cd contracts && npx hardhat compile 2>/dev/null; then
      echo -e "${RED}✗ Solidity compilation failed${NC}"
      FAILED=1
    fi
    cd ..
  fi
fi

# ─── Result ────────────────────────────────────────────────
if [ $FAILED -eq 1 ]; then
  echo ""
  echo -e "${RED}✗ Pre-commit checks failed. Fix errors and try again.${NC}"
  echo "  To skip: git commit --no-verify"
  exit 1
fi

echo -e "${GREEN}✓ Pre-commit checks passed${NC}"
exit 0
